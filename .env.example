# ==============================================================================
# ASHLYNX WEBSEC SCANNER - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and adjust variables as needed for local development.
# Never commit active credentials or sensitive keys to source control.

# --- General System Settings ---
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_NAME="Ashlynx WebSec Scanner"
APP_VERSION="2.0.0-dev"
SECRET_KEY="generate-a-secure-random-32-byte-hex-string-for-production"
API_PREFIX="/api/v1"

# --- Backend API Server ---
HOST=127.0.0.1
PORT=8000
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# Optional static API token required when exposing API beyond loopback:
# API_AUTH_TOKEN=
ENFORCE_LOCAL_BOUNDARY=true

# --- PostgreSQL Relational Store ---
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ashlynx_websec
POSTGRES_USER=ashlynx_user
POSTGRES_PASSWORD=ashlynx_secure_password
DATABASE_URL=postgresql+asyncpg://ashlynx_user:ashlynx_secure_password@localhost:5432/ashlynx_websec

# --- Redis Task Queue & Cache ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# --- Scanner Egress & Scope Engine ---
MAX_CONCURRENT_REQUESTS=10
DEFAULT_REQUEST_TIMEOUT=15.0
SCANNER_USER_AGENT="Ashlynx-WebSec-Scanner/2.0 (+https://ashlynxcyber.in/security-scanner)"
STRICT_SSRF_PROTECTION=true
ALLOW_PRIVATE_IPS=false
RATE_LIMIT_RPS=10.0

# --- Evidence & Cryptography ---
EVIDENCE_ENCRYPTION_KEY="32-byte-base64-encoded-aes-gcm-master-key"
EVIDENCE_RETENTION_DAYS=90

# --- Frontend Application ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME="Ashlynx WebSec Scanner"
